// UAR15.dll resources: the encrypted assets and the version/credits block.
#include "version.h"

// The UAR-15 runtime assets as one encrypted payload. build.bat first runs tools\pack over Assets\
// (generated from the user's own export by tools\prep, never in the repo): every asset is AES-256-GCM
// encrypted with a per-build key, so the DLL holds no extractable PNG or OBJ (src\payload.h).
DATA RCDATA "build\\gen\\payload.bin"

// Shown in the DLL's Properties > Details in Windows.
1 VERSIONINFO
FILEVERSION UAR15_VERSION_NUM
PRODUCTVERSION UAR15_VERSION_NUM
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x2
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RemArrow"
            VALUE "FileDescription", "UAR-15 - GML plugin for Geronimo (personal use)"
            VALUE "FileVersion", UAR15_VERSION
            VALUE "InternalName", "UAR15"
            VALUE "OriginalFilename", "UAR15.dll"
            VALUE "ProductName", "UAR-15"
            VALUE "ProductVersion", UAR15_VERSION
            VALUE "LegalCopyright", UAR15_MODEL_CREDIT ". Plugin code by RemArrow."
            VALUE "Comments", "Not affiliated with or endorsed by Bonewar, Stress Level Zero or Dark Matter Studios. Do not distribute."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
